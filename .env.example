# ForgeGuardian local development environment
# Copy to .env and fill in values — never commit .env
#
# Quick setup: run `fgctl setup` to generate this file interactively.

# ── Dashboard authentication ──────────────────────────────────────────────
# Set these to enable login on the web dashboard (http://localhost:3000).
# Without them the dashboard runs in open-access dev mode (no login required).
FG_ADMIN_EMAIL=admin@example.com
FG_ADMIN_PASSWORD=changeme
FG_SESSION_SECRET=generate-a-random-64-char-hex-string

# ── AI features ───────────────────────────────────────────────────────────
# Required for: fgctl advisory, fgctl patch, dashboard AI advisory
ANTHROPIC_API_KEY=sk-ant-...

# ── Docker-compose dev defaults ───────────────────────────────────────────
POSTGRES_PASSWORD=devpassword
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GRAFANA_PASSWORD=admin
