    <mxCell id="DF1b" value="fgctl scan . → localscanner.Walk() → ParseManifest() → orchestrator.Scan() → 8 engines concurrent → MergeFindings() → []core.Finding → UI output / DB persist" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=8;fontColor=#aaaaaa;" vertex="1" parent="1">
      <mxGeometry x="30" y="820" width="700" height="18" as="geometry" />
    </mxCell>

    <mxCell id="DF2" value="Dashboard Scan Flow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="30" y="842" width="160" height="16" as="geometry" />
    </mxCell>
    <mxCell id="DF2b" value="Browser POST /api/v1/scan → TriggerScan() → downloadArtifact() → registry API → tarball → extractArchive() → temp dir → orchestrator.Scan() → findings → JSON response → ScanPage renders engine status bar" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=8;fontColor=#aaaaaa;" vertex="1" parent="1">
      <mxGeometry x="30" y="860" width="900" height="18" as="geometry" />
    </mxCell>

    <mxCell id="DF3" value="Signature Flow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=1;fontColor=#FFAB40;" vertex="1" parent="1">
      <mxGeometry x="30" y="882" width="100" height="16" as="geometry" />
    </mxCell>
    <mxCell id="DF3b" value="fgctl intel new → YAML file → fgctl intel validate (schema check) → fgctl intel test (download pkg + scan) → PR to signatures/ → CI validate.yml → build_bundle.py → dist/signatures.json → fgctl intel update pulls it → LoadStore() → NewWithIntelligence() uses it" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=8;fontColor=#aaaaaa;" vertex="1" parent="1">
      <mxGeometry x="30" y="900" width="1100" height="18" as="geometry" />
    </mxCell>

    <mxCell id="DF4" value="AI Patch Flow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=1;fontColor=#CC785C;" vertex="1" parent="1">
      <mxGeometry x="30" y="922" width="100" height="16" as="geometry" />
    </mxCell>
    <mxCell id="DF4b" value="fgctl patch . → fg-agent binary → planner reads findings → Claude tool-use loop → executor edits manifests → reviewer validates → agentBus.publish(events) → SSE stream → AgentsPage shows live feed" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=8;fontColor=#aaaaaa;" vertex="1" parent="1">
      <mxGeometry x="30" y="940" width="900" height="18" as="geometry" />
    </mxCell>

    <mxCell id="DF5" value="Alert Flow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=1;fontColor=#DD344C;" vertex="1" parent="1">
      <mxGeometry x="30" y="962" width="80" height="16" as="geometry" />
    </mxCell>
    <mxCell id="DF5b" value="Worker finds critical finding → CreateAlert() POST /api/v1/alerts → InsertAlert() into DB → AlertsPage useQuery polls GET /api/v1/alerts → dismiss button → DismissAlert() POST /api/v1/alerts/:id/dismiss" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=8;fontColor=#aaaaaa;" vertex="1" parent="1">
      <mxGeometry x="30" y="980" width="900" height="18" as="geometry" />
    </mxCell>

