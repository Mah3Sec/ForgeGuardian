# ForgeGuardian Test Environment — scanner container with all optional tools
FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git curl python3 py3-pip nodejs npm

WORKDIR /src
COPY . .

# Build fgctl and fg-agent
RUN go build -o /usr/local/bin/fgctl ./cmd/fgctl/main.go
RUN go build -o /usr/local/bin/fg-agent ./agent/main.go

# Install grype
RUN curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh \
    | sh -s -- -b /usr/local/bin

# Install osv-scanner
RUN go install github.com/google/osv-scanner/cmd/osv-scanner@latest \
    && cp /root/go/bin/osv-scanner /usr/local/bin/osv-scanner || true

# Install semgrep
RUN pip3 install semgrep --break-system-packages || true

# ─── Runtime ──────────────────────────────────────────────────────────
FROM golang:1.23-alpine

RUN apk add --no-cache python3 curl nodejs npm bash jq

COPY --from=builder /usr/local/bin/fgctl      /usr/local/bin/fgctl
COPY --from=builder /usr/local/bin/fg-agent   /usr/local/bin/fg-agent
COPY --from=builder /usr/local/bin/grype      /usr/local/bin/grype
COPY --from=builder /usr/local/bin/osv-scanner /usr/local/bin/osv-scanner 2>/dev/null || true

RUN mkdir -p /results /targets /projects

WORKDIR /workspace
