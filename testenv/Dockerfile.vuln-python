# Vulnerable Python API — intentionally insecure for ForgeGuardian scanner testing
FROM python:3.9-slim

WORKDIR /app
COPY . .

# Install the vulnerable dependency versions exactly as specified
RUN pip install --no-cache-dir -r requirements.txt flask==2.0.3

COPY app.py .

# Expose the vulnerable Flask app
EXPOSE 5000
CMD ["python", "-c", "
from flask import Flask, request
import app as vuln

flask_app = Flask(__name__)

@flask_app.route('/parse', methods=['POST'])
def parse():
    return str(vuln.parse_config(request.data.decode()))

@flask_app.route('/ping', methods=['GET'])
def ping():
    host = request.args.get('host', 'localhost')
    vuln.ping_host(host)
    return 'ok'

@flask_app.route('/health')
def health():
    return 'ok'

flask_app.run(host='0.0.0.0', port=5000)
"]
